{
  "name": "telegram",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port ${PORT:-3000}",
    "build": "pnpm --filter \"telegram^...\" build && vite build",
    "build:app": "vite build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "typecheck": "tsr generate && tsc --noEmit --incremental false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean": "rm -rf node_modules .output .tanstack dist"
  },
  "dependencies": {
    "@aomi-labs/account": "workspace:*",
    "@aomi-labs/client": "workspace:*",
    "@aomi-labs/react": "workspace:*",
    "@aomi-labs/widget": "workspace:*",
    "@privy-io/react-auth": "^3.27.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "lucide-react": "^0.500.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
    "@typescript-eslint/parser": "8.51.0",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.0",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "5.2.0",
    "@tanstack/router-cli": "1.167.41",
    "nitro": "3.0.260903-beta",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
