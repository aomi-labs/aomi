{
  "name": "telegram",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --no-turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean": "rm -rf node_modules .next"
  },
  "dependencies": {
    "@aomi-labs/account": "workspace:*",
