    "@getpara/user-management-client": "3.12.0",
    "@getpara/viem-v2-integration": "3.12.0",
    "@tanstack/react-query": "^5.90.10",
    "next": "16.3.0",
    "ox": "0.11.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.47.11"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
