    "@aomi-labs/react": "workspace:*",
    "@aomi-labs/widget-lib": "workspace:*",
    "@privy-io/react-auth": "^3.27.1",
    "@tanstack/react-query": "^5.90.10",
    "lucide-react": "^0.500.0",
    "next": "16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
