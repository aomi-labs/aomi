{
  "name": "aomi-edge",
  "version": "0.1.0",
  "private": true,
  "description": "aomi-cloudflare: the Cloudflare Worker that is the public edge for api.aomi.dev and the app origins' API paths.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --root ../.. apps/edge",
    "typecheck": "tsc --noEmit",
    "generate-key": "node scripts/generate-key.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@aomi-labs/account": "workspace:*",
    "@aomi-labs/deploy": "workspace:*",
    "@aomi-labs/internal": "workspace:*",
    "@aomi-labs/service-identity": "workspace:*",
    "jose": "^6.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
