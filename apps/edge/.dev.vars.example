# Local Wrangler dev bindings. Copy to .dev.vars (gitignored).
# The dev signing key for topology node aomi-edge; its public key is committed
# in packages/service-identity/src/topologies.ts (default topology). Development only.
EDGE_SERVICE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIAJez/5pUy9hG5xNVsHP+4GQ6ZgxHDdzFoZ2GwvkHgx/\n-----END PRIVATE KEY-----"
EDGE_TOPOLOGY=default
BACKEND_ORIGINS=http://127.0.0.1:8080
API_SERVER_ORIGIN=http://127.0.0.1:8083
CORS_ALLOWED_HOST_PATTERNS=localhost:3000,127.0.0.1:3000
# Portal surface: serve the portal's moved routes for this host and pass the rest
# to the TanStack dev server. A hosted PORTAL_PAGES Worker service binding
# replaces this HTTP upstream; it is a Wrangler binding, not a string variable.
PORTAL_HOSTS=localhost:8787
PORTAL_UPSTREAM_ORIGIN=http://localhost:3001
PAYMENT_ORIGIN=http://127.0.0.1:8084
# Build surface: serve Build's moved routes for this host and pass the rest to
# the Build dev server. Locally, give Build's BUILD_SESSION_SECRET the same
# development value. Hosted secrets come only from product-mono's GitHub
# Environments, pushed by its deploy.
BUILD_HOSTS=localhost:8788
BUILD_UPSTREAM_ORIGIN=http://localhost:3002
BUILD_SESSION_SECRET=development-only-build-session-secret
BUILD_DEFAULT_PLATFORM=web
# Read access to the template and project repos for the release-manifest secret gate.
BUILD_GITHUB_TOKEN=
# Account surface: Better Auth on the local database (the Hyperdrive binding's
# local connection string, CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE).
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=development-only-better-auth-secret-32-bytes
AOMI_TRUSTED_ORIGINS=http://localhost:8787
# Provider settings differ by environment; leave blank to disable locally.
PRIVY_APP_ID=
PARA_JWT_AUDIENCE=
PARA_JWKS_URL=
PARA_API_BASE_URL=

# Deploy-only input to scripts/deploy.mjs (not a runtime string variable):
# PORTAL_PAGES_SERVICE names the already deployed page Worker in the same account.
# Unset retains PORTAL_UPSTREAM_ORIGIN. Target must not be the Edge Worker itself.

# Optional hosted migration policy, supplied only from committed environment config:
# PORTAL_LEGACY_AUTH={"origin":"https://old-portal.example","expiresAt":"<UTC deadline>"}
# BETTER_AUTH_URL remains the new primary. Legacy host must also be in PORTAL_HOSTS.
# Old issuance/discovery/validation stops at the deadline; never retire without
# the measured client/refresh-token lifetime gate. Unset leaves alias behavior unchanged.
