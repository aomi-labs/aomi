{"openapi":"3.1.0","info":{"title":"Aomi Labs Task API","version":"1.0.0","description":"Aomi Labs builds the execution harness for onchain finance. The Task API lets wallet-controlled agents pay 0.01 USDC to prepare and simulate an onchain plan, inspect the seller-attested preview for free, then buy the frozen unsigned bundle for 3% of simulated gross outgoing USDC. The buyer's wallet signs and broadcasts; Aomi never holds keys or funds.","x-guidance":"POST intent, chainId and sender to /v1/task/build. Pay 0.01 USDC by repeating the same request with Payment-Signature. Save quoteId and private retrievalToken. Poll the supplied status URL for free; verify the signed preview and price with trusted JWKS. POST the token to the result URL and pay its 3% fee with a second same-body retry. Zero outflow needs no second payment. Persist a separate payment-identifier and signed proof per purchase; never replace an ambiguous payment. No TaskAuthorization is required and no transaction execution is included.","contact":{"url":"https://aomi.dev/agents","email":"contact@foameo.ai"}},"externalDocs":{"url":"https://aomi.dev/docs/integrate/task-api","description":"Task API integration guide and two-purchase payment flow"},"servers":[{"url":"https://api-staging.aomi.dev"}],"paths":{"/.well-known/jwks.json":{"get":{"operationId":"signingJwks","security":[],"summary":"Public signing keys for verifying Aomi API attestations","responses":{"200":{"description":"Ed25519 verification keys; contains no private key material","content":{"application/json":{"schema":{"type":"object","required":["keys"],"properties":{"keys":{"type":"array","items":{"type":"object","required":["kty","crv","alg","kid","x"],"properties":{"kty":{"const":"OKP"},"crv":{"const":"Ed25519"},"alg":{"const":"EdDSA"},"kid":{"type":"string"},"x":{"type":"string"}}}}}}}}}}}},"/v1/task/build":{"get":{"operationId":"discoverTaskPayment","security":[],"summary":"Read-only Task payment metadata","description":"Returns public instructions for the payable POST. A valid POST returns a body-bound x402 v2 Payment-Required challenge; a GET cannot buy preparation and does not advertise a payable challenge. No signature or authorization is required for this metadata.","responses":{"200":{"description":"Task payment metadata","content":{"application/json":{"schema":{"type":"object","required":["endpoint","method","paymentProtocol","paymentScheme","networks","asset","preparationPriceMicroUsdc","retrievalPrice","openapi","exampleRequest","paymentInstructions"],"properties":{"endpoint":{"type":"string","format":"uri"},"method":{"const":"POST"},"paymentProtocol":{"type":"string"},"paymentScheme":{"type":"string"},"networks":{"type":"array","items":{"type":"string"}},"asset":{"type":"string"},"preparationPriceMicroUsdc":{"type":"string"},"retrievalPrice":{"type":"string"},"openapi":{"type":"string","format":"uri"},"exampleRequest":{"type":"object","description":"Unsigned JSON body that reaches the body-bound preparation challenge on an enabled network."},"paymentInstructions":{"type":"string"}}}}}},"default":{"$ref":"#/components/responses/Error"}}},"post":{"operationId":"prepareTask","security":[],"summary":"Purchase one preparation attempt for 0.01 USDC","description":"Validate intent, then pay the x402 challenge by retrying the same body. Returns a private job capability. Preparation attempts are non-refundable; no TaskAuthorization or execution signature is required.","parameters":[{"in":"header","name":"Payment-Signature","schema":{"type":"string"}}],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.01"},"protocols":[{"x402":{"scheme":"GatewayWalletBatched"}}]},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["intent","chainId","sender"],"properties":{"executionKind":{"enum":["eoa_transactions","smart_account_calls"],"default":"eoa_transactions"},"transactionSafetyMode":{"$ref":"#/components/schemas/TransactionSafetyMode","description":"EVM transaction safety selection. Initial build, stage, and Task requests use the account default when omitted. Simulation and commit inherit the sealed Build selection when omitted; an explicit override requires a fresh assessment and review."},"intent":{"type":"string","minLength":1,"maxLength":8000,"example":"Simulate a no-op on Arc Mainnet. Do not sign or broadcast any transaction."},"chainId":{"type":"integer","enum":[5042002,5042],"example":5042},"sender":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$","example":"0x000000000000000000000000000000000000dEaD"},"payer":{"type":"string"},"calls":{"type":"array","maxItems":16,"default":[],"description":"Exact ordered inner calls. Allowed only with smart_account_calls; simulated without planner reconstruction.","items":{"$ref":"#/components/schemas/TaskWalletCall"}},"constraints":{"type":"object","additionalProperties":false,"properties":{"maxOutgoingUsdcWei":{"type":"string","pattern":"^[0-9]+$","description":"Maximum gross outgoing native USDC in 18-decimal base units, represented as an integer string."},"maxGasUnits":{"type":"integer","format":"uint64","minimum":0,"description":"Maximum simulated gas units across all actions."},"allowedTargets":{"type":"array","default":[],"items":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},"description":"If nonempty, every action target must be in this allowlist."},"minimumReceived":{"type":"array","default":[],"items":{"type":"object","additionalProperties":false,"required":["asset","amount"],"properties":{"asset":{"type":"string","description":"Currently supported: native (18-decimal USDC units) or Arc USDC precompile 0x3600000000000000000000000000000000000000 (6-decimal units). Other assets fail closed because received-balance evidence is unavailable."},"amount":{"type":"string","pattern":"^[0-9]+$","description":"Minimum net increase in the sender balance across the simulated batch, in the specified asset's base units."}}}}}}}},"example":{"intent":"Simulate a no-op on Arc Mainnet. Do not sign or broadcast any transaction.","chainId":5042,"sender":"0x000000000000000000000000000000000000dEaD"}}}},"responses":{"202":{"description":"Preparation payment pending or accepted; quoteId, retrievalToken, statusUrl, resultUrl, retryAfter","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskJob"}}}},"402":{"description":"0.01 USDC preparation challenge","headers":{"Payment-Required":{"schema":{"type":"string"}}}},"422":{"description":"Invalid input; not charged"},"default":{"$ref":"#/components/responses/Error"}}}},"/v1/task/{quoteId}/status":{"post":{"operationId":"taskStatus","security":[],"summary":"Free progress, terminal failure, or attested preview and 3% retrieval quote","parameters":[{"in":"path","name":"quoteId","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["retrievalToken"],"properties":{"retrievalToken":{"type":"string","writeOnly":true}}}}}},"responses":{"200":{"description":"Free progress, terminal failure, or attested preview and 3% retrieval quote","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskProgress"}}}},"202":{"description":"Work or payment pending; retry existing job","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskProgress"}}}},"404":{"description":"Unknown job or invalid capability"},"default":{"$ref":"#/components/responses/Error"}}}},"/v1/task/{quoteId}/result":{"post":{"operationId":"taskResult","security":[],"summary":"Purchase frozen bundle for 3% of gross outgoing USDC; zero outflow is free. Repeat retrieval lasts 30 days","parameters":[{"in":"path","name":"quoteId","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"header","name":"Payment-Signature","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"sche