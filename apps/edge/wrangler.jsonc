{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One configuration for every environment. Staging, rc and production run
  // the same Worker build with the same settings; what differs per environment
  // (the Worker script name, its routes, its hosts, CORS and the origins it
  // forwards to) is inventory, recorded in product-mono's
  // infra/cloudflare/edge-environments.json and passed in by scripts/deploy.mjs.
  // `wrangler dev` uses this file as is, with .dev.vars for local bindings.
  "name": "aomi-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "workers_dev": false,
  "observability": { "enabled": true },
  // The Task discovery challenge cache. Once a namespace exists, bind it here
  // as EDGE_CACHE; the Worker falls back to an in-isolate cache without it.
  // "kv_namespaces": [{ "binding": "EDGE_CACHE", "id": "" }],
  // Once-only OIDC `jti` claims for the RC test identity (src/api/rc-replay.ts).
  // The binding is inert wherever RC_OIDC_* is unset: only the rc topology uses it.
  "durable_objects": { "bindings": [{ "name": "RC_OIDC_REPLAY", "class_name": "RcReplayStore" }] },
  "migrations": [{ "tag": "rc-replay-1", "new_sqlite_classes": ["RcReplayStore"] }],
  "vars": {
    // A placement miss wakes the backend reconciler; keep the original
    // request at the edge while the small hosted artifact materializes.
    "HOSTED_APP_WARMUP_ATTEMPTS": "10",
    "HOSTED_APP_WARMUP_RETRY_MS": "1000"
  }
}
