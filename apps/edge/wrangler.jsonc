{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aomi-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    "staging": {
      // api-staging is the venue, CLI and MCP host. The portal host is routed on
      // its API paths only (cookies stay host-only; the UI stays on Vercel).
      // chat-staging.aomi.dev must be proxied by Cloudflare (orange cloud) for
      // these routes to take effect.
      "routes": [
        { "pattern": "api-staging.aomi.dev/*", "zone_name": "aomi.dev" },
        { "pattern": "chat-staging.aomi.dev/api/*", "zone_name": "aomi.dev" },
        { "pattern": "chat-staging.aomi.dev/v1/*", "zone_name": "aomi.dev" },
        { "pattern": "chat-staging.aomi.dev/.well-known/*", "zone_name": "aomi.dev" },
        { "pattern": "build-staging.aomi.dev/api/*", "zone_name": "aomi.dev" },
        { "pattern": "build-staging.aomi.dev/v1/*", "zone_name": "aomi.dev" }
      ],
      // The Task discovery challenge cache. Create once per environment with
      // `wrangler kv namespace create EDGE_CACHE --env staging` and paste the id;
      // the Worker falls back to an in-isolate cache while the binding is absent.
      // "kv_namespaces": [{ "binding": "EDGE_CACHE", "id": "" }],
      "vars": {
        // BACKEND_ORIGINS, API_SERVER_ORIGIN and PAYMENT_ORIGIN are not
        // configured here: scripts/deploy.mjs passes them from the deploy
        // environment, which product-mono derives from its Terraform inventory.
        // A placement miss wakes the backend reconciler; keep the original
        // request at the edge while the small hosted artifact materializes.
        "HOSTED_APP_WARMUP_ATTEMPTS": "10",
        "HOSTED_APP_WARMUP_RETRY_MS": "1000",
        "MANAGER_ORIGIN": "https://manager-staging-tunnel.aomi.dev",
        "EDGE_TOPOLOGY": "staging",
        // The portal surface. PORTAL_UPSTREAM_ORIGIN (the portal's Vercel
        // alias) comes from the deploy environment like the other origins.
        "PORTAL_HOSTS": "chat-staging.aomi.dev",
        "APP_CATALOG_PLATFORMS": "",
        // The Build surface. BUILD_UPSTREAM_ORIGIN (Build's Vercel alias) comes
        // from the deploy environment; BUILD_SESSION_SECRET is a Wrangler secret.
        "BUILD_HOSTS": "build-staging.aomi.dev",
        "APP_DEPLOY_PLATFORMS": "",
        "CORS_ALLOWED_HOST_PATTERNS": "*.aomi.dev,*.staging.aomi.dev,api-staging.aomi.dev,chat-staging.aomi.dev,build-staging.aomi.dev,*.vercel.app,dev.wcm.inc",
        // Exact browser origins allowed to read Task challenges without credentials.
        // They receive no CORS access to the general /api routes.
        "TASK_CORS_PUBLIC_ORIGINS": "https://stableops.dev"
      }
    },
    "production": {
      // Production portal host routes are added at cutover once the host is
      // confirmed (chat.aomi.dev) and proxied by Cloudflare; see the README.
      "routes": [{ "pattern": "api.aomi.dev/*", "zone_name": "aomi.dev" }],
      // "kv_namespaces": [{ "binding": "EDGE_CACHE", "id": "" }],
      "vars": {
        "HOSTED_APP_WARMUP_ATTEMPTS": "10",
        "HOSTED_APP_WARMUP_RETRY_MS": "1000",
        "MANAGER_ORIGIN": "https://manager-2.aomi.dev",
        "EDGE_TOPOLOGY": "production",
        "PORTAL_HOSTS": "",
        "APP_CATALOG_PLATFORMS": "",
        // build.aomi.dev routes are added at cutover once the host is proxied by Cloudflare.
        "BUILD_HOSTS": "",
        "APP_DEPLOY_PLATFORMS": "",
        "CORS_ALLOWED_HOST_PATTERNS": "*.aomi.dev,api.aomi.dev,*.vercel.app"
      }
    }
  }
}
