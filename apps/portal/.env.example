# Portal environment: every real secret and per-environment value, nothing else.
# Copy to apps/portal/.env.local for local runs. Hosted values live in the
# chat-portal Vercel project, one name per value. Rules: AGENTS.md, "Secrets and
# env vars".

# --- Secrets (server only) ---
# Better Auth signing secret. Development and test fall back to a dev value.
BETTER_AUTH_SECRET=
# Postgres shared by Better Auth and the account graph. Required everywhere.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aomi
# Privy REST secret, for listing a user's embedded wallets.
PRIVY_APP_SECRET=
# Para REST key, for listing a user's embedded wallets.
PARA_API_SECRET_KEY=
# Alchemy key for SIWE smart-wallet checks. Unset uses each chain's public RPC.
ALCHEMY_API_KEY=

# --- Per-environment values (server) ---
# The portal's own origin, issuer of sessions and OAuth tokens.
BETTER_AUTH_URL=http://localhost:3001
# Extra origins Better Auth trusts, such as the public host in front of Vercel.
# AOMI_TRUSTED_ORIGINS=
# The public agent API behind /v1 discovery (required on Vercel).
AOMI_AGENT_API_URL=http://127.0.0.1:8082
# Privy app id and token verification keys for provider sign-in.
PRIVY_APP_ID=
PRIVY_JWT_VERIFICATION_KEY=
PRIVY_IDENTITY_JWT_VERIFICATION_KEY=
# Para JWT audience (its own id, not the API key) and JWKS.
PARA_JWT_AUDIENCE=
PARA_JWKS_URL=
# The one header a self-hosted edge overwrites with the client IP, such as
# x-real-ip. Vercel needs nothing here.
# AOMI_CLIENT_IP_HEADER=x-real-ip

# --- Per-environment values (browser) ---
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA
# Reown/WalletConnect project id.
NEXT_PUBLIC_PROJECT_ID=
