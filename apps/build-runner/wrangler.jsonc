{
  "name": "aomi-build-runner-staging",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "RUNS", "class_name": "BuildRun" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuildRun"] }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "aomi-build-artifacts-staging" }],
  "containers": [{
    "class_name": "BuildRun",
    "image": "registry.cloudflare.com/210e3092c7936592ca2078b5e26f7ea2/aomi-build-runner:release-required",
    "max_instances": 4,
    "instance_type": "standard-3"
  }]
}
