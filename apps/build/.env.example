# Aomi Build environment: every real secret and per-environment value, nothing
# else. Copy to apps/build/.env.local for local runs. Hosted values live in the
# aomi-build Vercel project, one name per value. Rules: AGENTS.md, "Secrets and
# env vars". The edge Worker serves Build's sign-in and control-plane routes;
# its secrets live in product-mono's GitHub Environments, not here.

# --- Secrets (server only) ---
# HS256 key of the aomi_github session cookie and CLI bearer, for the build-run
# and integration routes still served here. Same value as the edge's
# BUILD_SESSION_SECRET, rotated together from product-mono's GitHub Environment.
# At least 16 characters.
BUILD_SESSION_SECRET=
# aomi-build Ed25519 key (PKCS#8 PEM) that mints sandbox sidecar bearers. Its
# public half is committed in packages/service-identity/src/topologies.ts.
BUILD_SERVICE_PRIVATE_KEY=
# Bearer the Supabase pg_cron supervisor tick presents to the supervise route.
BUILD_RUN_CHECKER_CRON_SECRET=
# Shared Postgres for build-run state (sandbox runner and web tier).
SMITHER_DATABASE_URL=
# Model key for the build agent (OpenRouter is the default provider).
SMITHER_OPENROUTER_API_KEY=

# --- Per-environment values ---
# The backend whose committed topology the sidecar bearers are signed for.
# Required on Vercel. Local runs default to http://127.0.0.1:8080.
BACKEND_URL=http://127.0.0.1:8080
# Build execution: "local" (in process) or "sandbox".
AOMI_BUILD_RUNNER=local
# Runner image for the sandbox runner.
# AOMI_RUNNER_IMAGE=
# Browser switch for the smither build engine UI.
# NEXT_PUBLIC_BUILD_ENGINE=smither

# --- Local development only ---
# AOMI_BUILD_ALLOW_ANON=1
