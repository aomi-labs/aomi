# Build server sandbox orchestration (auth and control-plane APIs run on Edge).
# Service signing key: stored in the product-mono GitHub Environment.
BUILD_SERVICE_PRIVATE_KEY=
# GitHub cookie secret: shared with Edge, with one source in GitHub Environment.
BUILD_SESSION_SECRET=
# Backend target selects the matching committed service topology.
BACKEND_URL=http://127.0.0.1:8080
# Vercel Sandbox image and durable build state.
AOMI_RUNNER_IMAGE=
SMITHER_DATABASE_URL=
