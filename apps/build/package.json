{
  "name": "aomi-build",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm --filter \"aomi-build^...\" build && vite build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "lint": "eslint .",
    "type-check": "tsr generate && tsc --noEmit --incremental false",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rm -rf .output dist node_modules"
  },
  "dependencies": {
    "@aomi-labs/account": "workspace:*",
    "@aomi-labs/observability": "workspace:*",
    "@aomi-labs/client": "workspace:*",
    "@aomi-labs/deploy": "workspace:*",
    "@aomi-labs/react": "workspace:*",
    "@aomi-labs/smither": "workspace:*",
    "@aomi-labs/widget": "workspace:*",
    "@assistant-ui/react": "^0.14.0",
    "@assistant-ui/react-markdown": "^0.14.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@solana/wallet-standard-wallet-adapter-react": "1.1.4",
    "@tanstack/react-query": "5.104.1",
    "@vercel/sandbox": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.500.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.47.11",
    "zod": "^3.25.76",
    "@sentry/tanstackstart-react": "10.69.0",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "cookie-es": "2.0.0",
    "nitro": "3.0.260903-beta"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^9.39.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vite": "8.3.4",
    "@tanstack/router-cli": "1.167.41",
    "@typescript-eslint/parser": "8.51.0",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  }
}
