# Backend the BFF proxy forwards to.
BACKEND_URL=https://api.aomi.dev

# --- BFF proxy (proxy-mint model) ---
# EdDSA signing key for the AccountBearer (the one secret; topology TOML is committed).
PORTAL_SERVICE_PRIVATE_KEY=

# --- Provider credential verification (Privy / Para) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_JWT_VERIFICATION_KEY=
NEXT_PUBLIC_PARA_API_KEY=
PARA_API_KEY_ID=
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA
