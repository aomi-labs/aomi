
# Landing environment: every real secret and per-environment value, nothing
# else. Hosted values live in the landing-page Vercel project. Rules: AGENTS.md,
# "Secrets and env vars". Landing holds no secrets: its /api proxy forwards
# anonymously and never mints a bearer.

# Backend the /api proxy forwards to. Required on Vercel.
BACKEND_URL=https://api.aomi.dev

# --- Browser ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Wallet providers for the widget demos.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA
# Reown/WalletConnect project id.
NEXT_PUBLIC_PROJECT_ID=
