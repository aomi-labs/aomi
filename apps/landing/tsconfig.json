{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/components/examples/*": [
        "./content/components/examples/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@/content/*": [
        "./content/*"
      ],
      "@/.source/*": [
        "./.source/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@aomi-labs/react": [
        "../../packages/react/src/index.ts"
      ],
      "@aomi-labs/react/*": [
        "../../packages/react/src/*"
      ],
      "@aomi-labs/client": [
        "../../packages/client/src/index.ts"
      ],
      "@aomi-labs/client/*": [
        "../../packages/client/src/*"
      ],
      "@aomi-labs/account": [
        "../../packages/account/src/index.ts"
      ],
      "@aomi-labs/account/*": [
        "../../packages/account/src/*"
      ],
      "@assistant-ui/react": [
        "./node_modules/@assistant-ui/react"
      ],
      "@assistant-ui/react/*": [
        "./node_modules/@assistant-ui/react/*"
      ],
      "@assistant-ui/react-markdown": [
        "./node_modules/@assistant-ui/react-markdown"
      ],
      "@assistant-ui/react-markdown/*": [
        "./node_modules/@assistant-ui/react-markdown/*"
      ],
      "@getpara/react-sdk": [
        "./node_modules/@getpara/react-sdk"
      ],
      "@getpara/react-sdk/*": [
        "./node_modules/@getpara/react-sdk/*"
      ],
      "@tanstack/react-query": [
        "./node_modules/@tanstack/react-query"
      ],
      "@tanstack/react-query/*": [
        "./node_modules/@tanstack/react-query/*"
      ],
      "viem": [
        "./node_modules/viem"
      ],
      "viem/*": [
        "./node_modules/viem/*"
      ],
      "wagmi": [
        "./node_modules/wagmi"
      ],
      "wagmi/*": [
        "./node_modules/wagmi/*"
      ],
      "zustand": [
        "./node_modules/zustand"
      ],
      "zustand/*": [
        "./node_modules/zustand/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "content/**/*.ts",
    "content/**/*.tsx",
    "content/**/*.mdx",
    ".source/**/*.ts",
    "source.config.ts",
    "vite.config.ts",
    "mdx.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output",
    ".tanstack",
    ".vercel"
  ]
}
