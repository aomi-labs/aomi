# Aomi Portal/API origin. The browser talks to it directly (cross-origin).
VITE_AOMI_BASE_URL=https://chat.aomi.dev

# Optional: pin a hosted App by numeric id. Leave empty to use the default
# Agent routing (no App required).
VITE_AOMI_APPLICATION_ID=

# Optional "verify before sign" allowlist: comma-separated contract or
# recipient addresses. When set, Approve stays disabled unless every
# transaction targets one of these addresses.
VITE_ALLOWED_TARGETS=
