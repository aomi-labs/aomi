# The Portal/BFF URL. Guest auth is created against this origin.
AOMI_BASE_URL=https://chat.aomi.dev
# Local Portal/API stack instead:
# AOMI_BASE_URL=http://localhost:3000

# Public device client ID (no client secret). Register one once with
# POST <AOMI_BASE_URL>/api/auth/oauth2/register — see packages/client/README.md
# ("Register an OAuth client").
AOMI_OAUTH_CLIENT_ID=
# Optional. Defaults to ~/.config/aomi/oauth-grants.json.
AOMI_OAUTH_STORE_PATH=

# The supplied-token example requires an exact resource and matching scopes.
AOMI_OAUTH_RESOURCE=https://chat.aomi.dev/v1/agent
# AOMI_OAUTH_RESOURCE=http://localhost:3000/v1/agent
AOMI_OAUTH_SCOPES=agent:read
AOMI_OAUTH_ACCESS_TOKEN=

# Optional walkthrough inputs.
AOMI_PIPELINE_APP=
AOMI_PIPELINE_OPERATION=
AOMI_PIPELINE_ARGS={}

# Optional: set all three to enable the Viem wallet adapter (set together or
# not at all). Use a throwaway development key; never a production key.
AOMI_PRIVATE_KEY=
EVM_CHAIN_ID=
EVM_RPC_URL=
# wallet-terminal signs in as a guest unless this is "siwe" (needs the three above).
AOMI_WALLET_AUTH=guest
# Signed-in bearer used by the account credit example. Keep it out of source.
AOMI_ACCOUNT_BEARER=
# Optional. When set, the example purchases this many durable credits.
AOMI_TOP_UP_CREDITS=
# x402 settlement chain for the headless signer (Base Sepolia by default).
AOMI_PAYMENT_CHAIN_ID=84532
# auth:siws:disposable signs in on this Solana cluster (default solana:mainnet).
AOMI_SIWS_CHAIN_ID=
# custom-contract:anchor-root writes ANCHOR_ROOT to this registry on EVM_CHAIN_ID.
ANCHOR_REGISTRY_ADDRESS=
ANCHOR_ROOT=
