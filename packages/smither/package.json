{
  "name": "@aomi-labs/smither",
  "version": "0.1.2",
  "description": "Smithers-powered terminal orchestrator for building Aomi apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aomi-smither": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean:dist": "rm -rf dist"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "dependencies": {
    "@aomi-labs/deploy": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "effect": "3.21.4",
    "execa": "^9.6.0",
    "ink": "^7.1.0",
    "react": "^19.2.0",
    "smithers-orchestrator": "^0.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aomi-labs/internal": "workspace:*"
  }
}
