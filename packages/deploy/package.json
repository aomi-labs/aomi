{
  "name": "@aomi-labs/deploy",
  "version": "0.7.2",
  "description": "TypeScript toolkit for the Aomi platform deploy API: server client, drop-in BFF route factories, and a browser launch client. Root and ./bff entries are server-only.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lifecycle": {
      "import": {
        "types": "./dist/lifecycle.d.ts",
        "default": "./dist/lifecycle.js"
      },
      "require": {
        "types": "./dist/lifecycle.d.cts",
        "default": "./dist/lifecycle.cjs"
      }
    },
    "./bff": {
      "import": {
        "types": "./dist/bff/index.d.ts",
        "default": "./dist/bff/index.js"
      },
      "require": {
        "types": "./dist/bff/index.d.cts",
        "default": "./dist/bff/index.cjs"
      }
    },
    "./bff/errors": {
      "import": {
        "types": "./dist/bff/errors.d.ts",
        "default": "./dist/bff/errors.js"
      },
      "require": {
        "types": "./dist/bff/errors.d.cts",
        "default": "./dist/bff/errors.cjs"
      }
    },
    "./launch": {
      "import": {
        "types": "./dist/launch/index.d.ts",
        "default": "./dist/launch/index.js"
      },
      "require": {
        "types": "./dist/launch/index.d.cts",
        "default": "./dist/launch/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "clean:dist": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "fast-check": "^4.8.0"
  }
}
