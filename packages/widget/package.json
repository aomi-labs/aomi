{
  "name": "@aomi-labs/widget",
  "version": "5.0.2",
  "description": "Embeddable Aomi chat UI and wallet provider islands.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aomi-labs/aomi.git",
    "directory": "packages/widget"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "import": "./dist/frame.js"
    },
    "./host-composition": {
      "types": "./dist/host-composition.d.ts",
      "import": "./dist/host-composition.js"
    },
    "./control-bar": {
      "types": "./dist/control-bar.d.ts",
      "import": "./dist/control-bar.js"
    },
    "./browser-auth": {
      "types": "./dist/browser-auth.d.ts",
      "import": "./dist/browser-auth.js"
    },
    "./providers/para": {
      "types": "./dist/providers/para.d.ts",
      "import": "./dist/providers/para.js"
    },
    "./providers/privy": {
      "types": "./dist/providers/privy.d.ts",
      "import": "./dist/providers/privy.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./checkout": {
      "types": "./dist/checkout.d.ts",
      "import": "./dist/checkout.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.types.json && node scripts/build-package-types.mjs && node scripts/build-package-css.mjs",
    "clean:dist": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --exclude src/package-boundary.test.ts",
    "test:runtime-action": "vitest run --config vitest.config.ts src/sidebar/activity"
  },
  "dependencies": {
    "@aomi-labs/client": "workspace:*",
    "@aomi-labs/react": "workspace:*",
    "@assistant-ui/react": "0.14.26",
    "@assistant-ui/react-markdown": "0.14.5",
    "@assistant-ui/tap": "0.9.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-standard-wallet-adapter-react": "1.1.4",
    "@solana/web3.js": "^1.98.4",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.1.0",
    "@tanstack/react-query": "^5.90.10",
    "@x402/svm": "^2.21.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "lucide-react": "0.545.0",
    "motion": "^12.23.22",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "1.4.0",
    "uqr": "^0.1.2",
    "vaul": "^1.1.2",
    "viem": "^2.47.11",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "@better-auth/core": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@getpara/react-sdk": "2.19.0",
    "@getpara/wagmi-v2-connector": "2.19.0",
    "@privy-io/react-auth": "^2.0.0",
    "@privy-io/wagmi": "^1.0.0",
    "better-auth": "1.7.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@getpara/react-sdk": "2.19.0",
    "@getpara/wagmi-v2-connector": "2.19.0",
    "@privy-io/react-auth": "^2.0.0",
    "@privy-io/wagmi": "^1.0.0",
    "@solana/spl-token": "^0.4.15",
    "postcss": "^8.5.6",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  },
  "peerDependenciesMeta": {
    "@getpara/react-sdk": {
      "optional": true
    },
    "@getpara/wagmi-v2-connector": {
      "optional": true
    },
    "@privy-io/react-auth": {
      "optional": true
    },
    "@privy-io/wagmi": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "@better-auth/oauth-provider": {
      "optional": true
    },
    "@better-auth/core": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css",
    "./dist/providers/**/*.js"
  ]
}
