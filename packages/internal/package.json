{
  "name": "@aomi-labs/internal",
  "version": "0.1.0",
  "private": true,
  "description": "Typed clients for Aomi's non-core services (the manager control plane first). Server-only and runtime-agnostic (Node, Cloudflare Workers); the only place a BFF or the edge Worker may know an internal path. Never published.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manager": "./src/manager/index.ts",
    "./operate-format": "./src/operate/format.ts",
    "./operate-fixtures": "./src/operate/fixtures/index.ts",
    "./operate-fixtures/types": "./src/operate/fixtures/types.ts",
    "./operate-fixtures/wire": "./src/operate/fixtures/wire.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aomi-labs/deploy": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.8.0"
  }
}
