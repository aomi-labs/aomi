{
  "name": "@aomi-labs/client",
  "version": "0.10.2",
  "description": "Platform-agnostic TypeScript client for the Aomi backend API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aomi": "./bin/aomi.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser-auth": {
      "import": {
        "types": "./dist/browser-auth.d.ts",
        "default": "./dist/browser-auth.js"
      },
      "require": {
        "types": "./dist/browser-auth.d.cts",
        "default": "./dist/browser-auth.cjs"
      }
    },
    "./siws-client": {
      "import": {
        "types": "./dist/siws-client.d.ts",
        "default": "./dist/siws-client.js"
      },
      "require": {
        "types": "./dist/siws-client.d.cts",
        "default": "./dist/siws-client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean:dist": "rm -rf dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "better-auth": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/core": "1.7.1"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "^2.10.0",
    "@x402/evm": "^2.10.0",
    "@x402/fetch": "^2.10.0",
    "bs58": "^6.0.0",
    "jose": "^6.2.3",
    "tweetnacl": "^1.0.3",
    "viem": "^2.47.11"
  },
  "peerDependencies": {
    "better-auth": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/core": "1.7.1"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "@better-auth/oauth-provider": {
      "optional": true
    },
    "@better-auth/core": {
      "optional": true
    }
  }
}
