{
  "name": "@aomi-labs/client",
  "version": "0.11.2",
  "description": "Platform-agnostic TypeScript client for the Aomi backend API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aomi-labs/aomi.git",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser-auth": {
      "import": {
        "types": "./dist/browser-auth.d.ts",
        "default": "./dist/browser-auth.js"
      },
      "require": {
        "types": "./dist/browser-auth.d.cts",
        "default": "./dist/browser-auth.cjs"
      }
    },
    "./viem": {
      "import": {
        "types": "./dist/viem.d.ts",
        "default": "./dist/viem.js"
      },
      "require": {
        "types": "./dist/viem.d.cts",
        "default": "./dist/viem.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/solana.d.ts",
        "default": "./dist/solana.js"
      },
      "require": {
        "types": "./dist/solana.d.cts",
        "default": "./dist/solana.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean:dist": "rm -rf dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "better-auth": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/core": "1.7.1",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "dependencies": {
    "@x402/core": "^2.10.0",
    "@x402/evm": "^2.10.0",
    "@x402/fetch": "^2.10.0",
    "jose": "^6.2.3",
    "viem": "^2.47.11"
  },
  "peerDependencies": {
    "better-auth": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/core": "1.7.1",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "@better-auth/oauth-provider": {
      "optional": true
    },
    "@better-auth/core": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "bs58": {
      "optional": true
    },
    "tweetnacl": {
      "optional": true
    }
  }
}
