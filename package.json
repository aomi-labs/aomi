{
  "name": "aomi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter landing dev",
    "dev:landing:live": "pnpm --filter @aomi-labs/react exec tsup --watch & pnpm --filter landing dev",
    "dev:landing": "pnpm --filter landing dev",
    "dev:landing:ngrok": "./scripts/dev-landing-ngrok.sh",
    "dev:portal": "pnpm --filter portal dev",
    "dev:portal:localhost": "pnpm --filter portal dev:localhost",
    "dev:aomi-build": "pnpm --filter aomi-build dev",
    "dev:auth-stack": "./scripts/dev-auth-stack.sh",
    "dev:auth-stack:status": "./scripts/dev-auth-stack.sh status",
    "dev:auth-stack:stop": "./scripts/dev-auth-stack.sh stop",
    "smoke:auth-stack": "node ./scripts/smoke-auth-stack.mjs",
    "dev:telegram": "pnpm --filter telegram dev",
    "dev:telegram:webpack": "pnpm --filter telegram dev:webpack",
    "example:agent:guest": "pnpm --filter @aomi-labs/example-headless-client agent:guest",
    "example:pipeline:guest": "pnpm --filter @aomi-labs/example-headless-client pipeline:guest",
    "example:oauth": "pnpm --filter @aomi-labs/example-headless-client oauth",
    "example:oauth-token": "pnpm --filter @aomi-labs/example-headless-client oauth:token",
    "example:walkthrough": "pnpm --filter @aomi-labs/example-headless-client walkthrough",
    "example:wallet-terminal": "pnpm --filter @aomi-labs/example-headless-client wallet-terminal",
    "example:web-sign": "pnpm --filter @aomi-labs/example-web-sign dev",
    "example:auth:siws:disposable": "pnpm --filter @aomi-labs/example-headless-client auth:siws:disposable",
    "example:account:credits": "pnpm --filter @aomi-labs/example-headless-client account:credits",
    "example:custom-contract:anchor-root": "pnpm --filter @aomi-labs/example-headless-client custom-contract:anchor-root",
    "build:client": "pnpm --filter @aomi-labs/client build",
    "build:deploy": "pnpm --filter @aomi-labs/deploy build",
    "build:smither": "pnpm --filter @aomi-labs/smither build",
    "build:packages": "pnpm run build:client && pnpm --filter @aomi-labs/cli build && pnpm --filter @aomi-labs/react build && pnpm --filter @aomi-labs/account type-check && pnpm run build:deploy && pnpm run build:widget && pnpm run build:widget-compat",
    "build:landing": "pnpm --filter landing build",
    "build:portal": "pnpm --filter portal build",
    "build:aomi-build": "pnpm --filter aomi-build build",
    "build:telegram": "pnpm --filter telegram build",
    "build:apps": "pnpm run build:landing && pnpm run build:portal && pnpm run build:aomi-build && pnpm run build:telegram",
    "build:all": "pnpm run build:packages && pnpm run build:apps",
    "clean:landing": "rm -rf apps/landing/.next",
    "clean:apps": "rm -rf apps/landing/.next apps/portal/.next apps/build/.next apps/telegram/.next examples/embed-next/.next",
    "clean:packages": "pnpm --filter @aomi-labs/client clean:dist && pnpm --filter @aomi-labs/react clean:dist && pnpm --filter @aomi-labs/deploy clean:dist && pnpm --filter @aomi-labs/widget clean:dist && rm -rf packages/cli/dist packages/widget-lib/dist",
    "clean:next": "rm -rf .next apps/landing/.next apps/portal/.next apps/build/.next apps/telegram/.next examples/embed-next/.next",
    "clean:all": "rm -rf .next apps/landing/.next apps/portal/.next apps/build/.next apps/telegram/.next examples/embed-next/.next dist .turbo node_modules/.cache .eslintcache",
    "clean": "rm -rf .next apps/landing/.next apps/portal/.next apps/build/.next apps/telegram/.next examples/embed-next/.next dist .turbo node_modules/.cache .eslintcache",
    "vercel-build": "pnpm run build:client && pnpm --filter @aomi-labs/react build && if [ \"$VERCEL\" = \"1\" ]; then mkdir -p public/assets public/videos public/research && cp -r apps/landing/public/assets/. public/assets/ && cp -r apps/landing/public/videos/. public/videos/ && cp -r apps/landing/public/research/. public/research/; fi && pnpm --filter landing build",
    "lint": "eslint .",
    "lint:landing": "pnpm --filter landing lint",
    "lint:portal": "pnpm --filter portal lint",
    "lint:aomi-build": "pnpm --filter aomi-build lint",
    "lint:telegram": "pnpm --filter telegram lint",
    "lint:apps": "pnpm run lint:landing && pnpm run lint:portal && pnpm run lint:aomi-build && pnpm run lint:telegram",
    "typecheck": "tsc --noEmit --project tsconfig.lib.json",
    "typecheck:landing": "pnpm --filter landing exec tsc --noEmit --project tsconfig.json",
    "typecheck:portal": "pnpm --filter portal exec tsc --noEmit --project tsconfig.json",
    "typecheck:aomi-build": "pnpm --filter aomi-build exec tsc --noEmit --project tsconfig.json",
    "typecheck:telegram": "pnpm --filter telegram exec tsc --noEmit --project tsconfig.json",
    "typecheck:apps": "pnpm run typecheck:landing && pnpm run typecheck:portal && pnpm run typecheck:aomi-build && pnpm run typecheck:telegram",
    "test:portal": "pnpm --filter portal test",
    "test:telegram": "pnpm --filter telegram test:unit",
    "test:widget": "pnpm --filter @aomi-labs/widget test:unit",
    "test:openapi": "vitest run packages/client/src/backend-openapi.contract.test.ts",
    "generate:agent-api": "node scripts/generate-agent-api-contract.mjs",
    "check:agent-api": "node scripts/check-agent-api-contract.mjs",
    "sync:db-pool-budgets": "node scripts/sync-db-pool-budgets.mjs",
    "check:db-pool-budgets": "node scripts/sync-db-pool-budgets.mjs --check",
    "test:openapi:live": "node scripts/test-live-backend-openapi.mjs",
    "update:backend-openapi": "node scripts/update-backend-openapi.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm exec vitest run && pnpm run test:widget",
    "check:apps": "pnpm run lint:apps && pnpm run typecheck:apps && pnpm run test:portal && pnpm run test:telegram && pnpm run build:apps",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest",
    "generate:theme": "node ./scripts/generate-theme.mjs",
    "repowiki": "./scripts/repowiki",
    "repowiki:refresh": "./scripts/repowiki refresh",
    "repowiki:doctor": "./scripts/repowiki doctor",
    "test:contracts": "node scripts/check-consumer-compatibility.mjs",
    "check:frontend-boundaries": "node scripts/check-frontend-boundaries.mjs",
    "test:journeys": "playwright test --config=playwright.journeys.config.ts tests/e2e/journeys",
    "test:browser:contracts": "node scripts/test-browser-contracts.mjs",
    "test:browser:consumers": "node scripts/test-packed-consumers.mjs",
    "check:package-api": "node scripts/check-package-api.mjs",
    "check:fresh-widget": "node scripts/check-fresh-widget.mjs",
    "check:widget-docs": "node scripts/check-widget-docs.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "check:package-changesets": "node scripts/check-package-changesets.mjs",
    "build:widget": "pnpm --filter @aomi-labs/widget build",
    "build:widget-compat": "pnpm --filter @aomi-labs/widget-lib build",
    "smoke:local-runtime": "tsx scripts/smoke-local-runtime.ts"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "app/globals.css"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.46",
    "@assistant-ui/react": "0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.0",
    "@assistant-ui/react-markdown": "0.14.5",
    "@eslint/eslintrc": "^3",
    "@getpara/react-common": "2.19.0",
    "@getpara/react-components": "2.19.0",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.90.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.2",
    "ai": "^5.0.65",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "fast-check": "^4.8.0",
    "framer-motion": "^12.23.22",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.22",
    "next": "16.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-shiki": "^0.9.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "viem": "^2.47.11",
    "vitest": "^3.2.4",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.8",
    "@microsoft/api-extractor": "7.59.3",
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "@changesets/cli": "3.0.3"
  },
  "dependencies": {
    "@getpara/core-sdk": "2.24.0",
    "@getpara/user-management-client": "2.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  }
}
